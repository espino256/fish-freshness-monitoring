{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.role == 'admin')",
        ".write": "auth != null && auth.token.role == 'admin'",
        "role": {
          ".write": false
        }
      }
    },
    "samples": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'researcher' || auth.token.role == 'viewer')",
      "$sampleId": {
        ".write": "auth != null && (auth.token.role == 'admin' || (auth.token.role == 'researcher' && ((!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.child('ownerUid').val() == auth.uid && (!newData.exists() || newData.child('ownerUid').val() == auth.uid)))))",
        ".validate": "newData.hasChildren(['id', 'fishType', 'details', 'collectedAt', 'operatorName', 'remarks', 'ownerUid', 'updatedBy', 'updatedAt'])",
        "id": {
          ".validate": "newData.isString() && newData.val() == $sampleId"
        },
        "fishType": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "details": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "collectedAt": {
          ".validate": "newData.isString()"
        },
        "operatorName": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "remarks": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "updatedBy": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "readings": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'researcher' || auth.token.role == 'viewer')",
      "$readingId": {
        ".write": "auth != null && (auth.token.role == 'admin' || (auth.token.role == 'ph_device' && !data.exists() && newData.child('deviceId').val() == auth.uid))",
        ".validate": "newData.hasChildren(['ph', 'timestamp', 'deviceId'])",
        "ph": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "deviceId": {
          ".validate": "newData.isString()"
        },
        "sampleId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "analyses": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'researcher' || auth.token.role == 'viewer')",
      "$analysisId": {
        ".write": "auth != null && (auth.token.role == 'admin' || (auth.token.role == 'researcher' && !data.exists() && newData.child('createdBy').val() == auth.uid))",
        ".validate": "newData.hasChildren(['sampleId', 'storagePath', 'meanHue', 'classification', 'timestamp', 'createdBy'])",
        "sampleId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "storagePath": {
          ".validate": "newData.isString() && newData.val().beginsWith('samples/')"
        },
        "meanHue": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
        },
        "classification": {
          ".validate": "newData.isString() && (newData.val() == 'Fresh' || newData.val() == 'Moderate' || newData.val() == 'Spoiled' || newData.val() == 'Review required')"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "deviceUploads": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'researcher' || auth.token.role == 'viewer')",
      "$uploadId": {
        ".write": "auth != null && (auth.token.role == 'admin' || (auth.token.role == 'camera_device' && !data.exists() && newData.child('deviceId').val() == auth.uid))",
        ".validate": "newData.hasChildren(['sampleId', 'storagePath', 'timestamp', 'deviceId'])",
        "sampleId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
        },
        "storagePath": {
          ".validate": "newData.isString() && newData.val().length <= 240 && newData.val().matches(/^samples\\/[A-Za-z0-9_-]{1,100}\\/images\\/[A-Za-z0-9_-]+\\.jpg$/)"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "deviceId": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "devices": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'researcher' || auth.token.role == 'viewer')",
      "$deviceId": {
        ".write": "auth != null && (auth.token.role == 'admin' || ((auth.token.role == 'ph_device' || auth.token.role == 'camera_device') && newData.child('deviceUid').val() == auth.uid && newData.child('deviceId').val() == $deviceId))",
        ".validate": "newData.hasChildren(['online', 'lastSeen', 'deviceId', 'deviceUid'])"
      }
    },
    "calibrations": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'researcher' || auth.token.role == 'viewer')",
      "$calibrationId": {
        ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'ph_device')"
      }
    },
    "settings": {
      "classificationThresholds": {
        ".read": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'researcher' || auth.token.role == 'viewer')",
        ".write": "auth != null && auth.token.role == 'admin'"
      }
    }
  }
}
