{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['displayName', 'email', 'createdAt'])",
        "email": {
          ".validate": "newData.isString() && newData.val() == auth.token.email"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "telemetry": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.role != 'ph_device' && auth.token.role != 'camera_device'",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid && auth.token.role == 'ph_device' && newData.exists()",
        ".validate": "newData.hasChildren(['deviceId', 'ph', 'adcRaw', 'measuredVoltage', 'timestamp'])",
        "deviceId": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "ph": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
        },
        "adcRaw": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 4095"
        },
        "measuredVoltage": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3.3"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "readings": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.role != 'ph_device' && auth.token.role != 'camera_device'",
      ".indexOn": [
        "timestamp"
      ],
      "$id": {
        ".write": "auth != null && auth.token.role == 'ph_device' && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['deviceId', 'ph', 'adcRaw', 'measuredVoltage', 'timestamp'])",
        "deviceId": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "ph": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
        },
        "adcRaw": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 4095"
        },
        "measuredVoltage": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3.3"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "analyses": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.role != 'ph_device' && auth.token.role != 'camera_device'",
      ".indexOn": [
        "timestamp"
      ],
      "$id": {
        ".write": "(auth != null && auth.token.email_verified == true && auth.token.role != 'ph_device' && auth.token.role != 'camera_device') && (auth.token.role == 'inspector' || auth.token.role == 'admin') && !data.exists() && newData.exists() && newData.child('createdBy').val() == auth.uid",
        ".validate": "newData.hasChildren(['sampleId', 'storagePath', 'meanHue', 'classification', 'timestamp', 'createdBy'])",
        "sampleId": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,100}$/)"
        },
        "storagePath": {
          ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().beginsWith('samples/' + newData.parent().child('sampleId').val() + '/images/') && newData.val().matches(/^samples\\/[A-Za-z0-9_-]{1,100}\\/images\\/[A-Za-z0-9._-]+$/)"
        },
        "meanHue": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
        },
        "classification": {
          ".validate": "newData.val() == 'Fresh' || newData.val() == 'Moderate' || newData.val() == 'Spoiled'"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "meanSaturation": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "meanValue": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "redFraction": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "usableFraction": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
